{
  "$comment": "Generated from src/schema/v1.mjs. Cross-field rules are enforced by `reasonfrom validate`, not here.",
  "$id": "https://github.com/arunveersingh/reasonfrom-kit/schema/v1/course.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cover": {
      "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.(\\/|$))[A-Za-z0-9._\\-/]+$",
      "type": "string"
    },
    "external_url": {
      "format": "uri",
      "type": "string"
    },
    "id": {
      "pattern": "^course\\/[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "outline": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "line": {
                "minLength": 1,
                "type": "string"
              },
              "n": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "phase": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "n",
              "title",
              "phase"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "line_label": {
          "minLength": 1,
          "type": "string"
        },
        "phases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "question": {
                "minLength": 1,
                "type": "string"
              },
              "to": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "label",
              "from",
              "to"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "unit": {
          "enum": [
            "day",
            "lesson",
            "module"
          ],
          "type": "string"
        }
      },
      "required": [
        "unit",
        "phases",
        "entries"
      ],
      "type": "object"
    },
    "source_url": {
      "format": "uri",
      "type": "string"
    },
    "tagline": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "course",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "tagline",
    "source_url",
    "outline"
  ],
  "type": "object"
}
